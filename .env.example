# Backend only. Never prefix these values with VITE_ or expose them in frontend code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Generate a different random value with at least 32 characters.
SESSION_SECRET=replace_with_a_long_random_value
OTP_SECRET=replace_with_another_random_value_with_32_characters

# Meta WhatsApp Cloud API. Keep these only in the backend/Vercel environment.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=login_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_COUNTRY_CODE=55
OTP_RESPONSE_MIN_MS=750
# Fill only when the approved template uses a one-tap/copy-code button.
WHATSAPP_OTP_BUTTON_SUBTYPE=

# Pre-approved Meta templates for appointment reminders (official production path).
# Panel copy is stored in settings; it is not sent as Graph free text outside the 24h session window.
WHATSAPP_REMINDER_TEMPLATE_OWNER=
WHATSAPP_REMINDER_TEMPLATE_PROFESSIONAL=
WHATSAPP_REMINDER_TEMPLATE_CLIENT_PENDING=
WHATSAPP_REMINDER_TEMPLATE_CLIENT_CONFIRMED=
WHATSAPP_REMINDER_TEMPLATE_LANGUAGE=pt_BR

# Shared secret for POST /api/jobs/appointment-reminders (Authorization: Bearer).
CRON_SECRET=

# Production URL, for example https://agenda.example.com
APP_ORIGIN=http://localhost:5173
BUSINESS_TIMEZONE=America/Sao_Paulo
PORT=3001
